# Server-only. Configure in Netlify Functions environment, never VITE_*.
APP_ORIGIN=https://your-site.netlify.app
OIDC_ISSUER=https://your-provider.example/
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Generate 32 random bytes encoded as 64 hex characters.
COOKIE_KEY=
BLOBS_STORE=accounting-production
# Approved PostgreSQL JSON storage. Keep writes off until isolated deployment checks.
STORAGE_DRIVER=postgres
DATABASE_URL=
# Direct connection for schema setup (Neon provides this separately).
DATABASE_URL_UNPOOLED=
# Optional PEM CA for a provider using a private certificate authority.
DATABASE_CA_CERT=
ACCOUNTING_WRITES_ENABLED=false
# Optional invitation feature: separate server-only M2M app, test site only.
# Keep disabled until connection authorization and isolated tests are complete.
AUTH0_INVITATIONS_ENABLED=false
AUTH0_MGMT_DOMAIN=
AUTH0_MGMT_CLIENT_ID=
AUTH0_MGMT_CLIENT_SECRET=
AUTH0_DATABASE_CONNECTION=Username-Password-Authentication
